{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Device": {
      "title": "Device Registration",
      "description": "Information about a user registered device",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "deviceName": { "type": "string", "maxLength": 100 },
        "deviceType": { "type": "string", "enum": ["pc", "phone", "tablet", "other"] },
        "role": { "type": "string", "enum": ["host", "accessory", "both"] },
        "lastSeen": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["online", "offline"] }
      },
      "required": ["deviceId", "userId", "deviceName"]
    },
    "PairingSession": {
      "title": "Pairing Session",
      "description": "Ephemeral or saved pairing session linking a host and an accessory device",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 16 },
        "hostUserId": { "type": "string", "maxLength": 128 },
        "hostDeviceId": { "type": "string", "maxLength": 128 },
        "hostName": { "type": "string", "maxLength": 100 },
        "accessoryDeviceId": { "type": "string", "maxLength": 128 },
        "accessoryName": { "type": "string", "maxLength": 100 },
        "accessoryType": { "type": "string", "enum": ["all_in_one", "mouse_keyboard", "touchpad", "gyro_mouse", "speaker", "extra_monitor"] },
        "status": { "type": "string", "enum": ["waiting", "connected", "terminated"] },
        "permissionsGranted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "code", "hostUserId", "status"]
    },
    "SignalingMessage": {
      "title": "WebRTC Signaling and Real-Time Event Bus",
      "description": "Message channel for WebRTC negotiation or direct command syncing",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 64 },
        "senderId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["offer", "answer", "candidate", "command", "ping", "ack"] },
        "payload": { "type": "string", "maxLength": 65536 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "senderId", "type", "payload"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles with owner-only access"
    },
    "/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/Device" },
      "description": "Stores registered devices per user"
    },
    "/pairingSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/PairingSession" },
      "description": "Temporary and active pairing sessions"
    },
    "/pairingSessions/{sessionId}/signals/{signalId}": {
      "schema": { "$ref": "#/entities/SignalingMessage" },
      "description": "Subcollection for WebRTC signaling and real-time remote commands"
    }
  }
}
